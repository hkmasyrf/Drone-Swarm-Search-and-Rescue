<?xml version='1.0' encoding='UTF-8'?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code>;; ============================================================================
;; MODEL: Autonomous Drone Swarm Search &amp; Rescue (SAR) Reconnaissance
;; Real-World Urban Disaster Mapping, Stigmergy &amp; Casualty Geotagging
;; ============================================================================

globals [
  found-count           ;; Total survivors located and geotagged
  critical-found        ;; Count of critical (red) casualties located
  search-coverage       ;; Percentage of disaster terrain swept
  mission-status        ;; Operational status display
]

breed [ drones drone ]
breed [ halos halo ]
breed [ survivors survivor ]

drones-own [
  battery               ;; Flight endurance remaining
  my-halo               ;; Link to the drone's glowing radar circle
  my-found-count        ;; Individual casualty count tagged by this drone
]

halos-own [
  owner-drone           ;; The drone this radar follows
]

survivors-own [
  found?                ;; Has victim been detected and logged?
  priority              ;; "critical" (life-threatening) or "stable"
]

patches-own [
  obstacle?             ;; Solid building structure (aerial collision risk)
  scent-trail           ;; CA coverage memory (fades over time)
  visited?              ;; Has this patch been swept by radar?
]

;; ============================================================================
;; SETUP
;; ============================================================================

to setup
  clear-all
  reset-ticks
  set found-count 0
  set critical-found 0
  set search-coverage 0
  set mission-status "Sweeping City..."

  setup-patches
  setup-survivors
  setup-drones
  update-metrics
  setup-sar-plot
  update-sar-plot
end

to setup-patches
  ask patches [
    set obstacle? false
    set visited? false
    set scent-trail 0
    set pcolor [ 22 26 34 ]   ;; Dark satellite tactical ground
  ]

  ;; 1. MAIN HIGHWAY ARTERIES
  ask patches with [ abs pxcor &lt;= 2 or abs pycor &lt;= 2 ] [
    set pcolor [ 34 38 48 ]   ;; Dark asphalt
    if (pxcor = 0 and pycor mod 4 = 0) or (pycor = 0 and pxcor mod 4 = 0) [
      set pcolor [ 90 95 105 ] ;; Road dashes
    ]
  ]

  ;; 2. INCIDENT COMMAND BASE (Launch Tarmac at Bottom-Left)
  ask patches with [ pxcor &lt;= (min-pxcor + 10) and pycor &lt;= (min-pycor + 10) ] [
    set pcolor [ 28 36 48 ]
    set obstacle? false
    if (pxcor = min-pxcor + 10) or (pycor = min-pycor + 10) [
      set pcolor [ 80 110 140 ]
    ]
  ]

  ;; 3. NO PARK ZONE: the former green park area now uses the default
  ;; dark tactical ground colour, keeping the city map visually consistent.

  ;; --------------------------------------------------------------------------
  ;; 4. EXPANDED REALISTIC 3D BUILDINGS (8 Key Landmark Structures)
  ;; --------------------------------------------------------------------------
  ;; 1. Collapsed Industrial Warehouse (North-West)
  create-realistic-building (min-pxcor + 14) (max-pycor - 14) 5 4 "warehouse" true
  ;; 2. Urban Hospital with Helipad 'H' (North-East)
  create-realistic-building (max-pxcor - 14) (max-pycor - 14) 6 6 "hospital" true
  ;; 3. Corporate High-Rise Tower (Center-East)
  create-realistic-building (max-pxcor - 13) 10 5 5 "highrise" false
  ;; 4. Residential Apartment Complex (Center-North)
  create-realistic-building 9 (max-pycor - 13) 5 4 "residential" true
  ;; 5. Commercial Strip Center (Center-West)
  create-realistic-building (min-pxcor + 14) 10 4 5 "warehouse" true
  ;; 6. Collapsed High School (Central District)
  create-realistic-building -9 14 4 4 "warehouse" true
  ;; 7. Shopping Mall Complex (Central-South)
  create-realistic-building 14 -9 5 4 "highrise" true
  ;; 8. Fallen Residential Blocks (West-Central)
  create-realistic-building (min-pxcor + 15) -15 4 4 "residential" true
  ;; 9. Telecommunications Substation (South-West District)
  create-realistic-building 8 -25 3 3 "warehouse" true
  ;; 10. Community Center &amp; Gymnasium (South-West Perimeter)
  create-realistic-building -16 -8 3 2 "residential" true
end

;; Helper: 100% Observer-Safe 3D Building Generator
to create-realistic-building [ cx cy half-w half-h b-type collapsed? ]
  ;; 1. 3D Drop Shadows
  ask patches with [
    (pxcor &gt;= cx - half-w + 1 and pxcor &lt;= cx + half-w + 2) and
    (pycor &gt;= cy - half-h - 2 and pycor &lt;= cy + half-h - 1) and
    (pxcor &gt; cx + half-w or pycor &lt; cy - half-h)
  ] [
    set pcolor [ 12 14 18 ]
    set obstacle? false      ;; Airplanes fly over shadows
  ]

  ;; 2. Rooftop Surface &amp; Parapet Wall Rim
  ask patches with [ abs (pxcor - cx) &lt;= half-w and abs (pycor - cy) &lt;= half-h ] [
    set obstacle? true
    ifelse (abs (pxcor - cx) = half-w or abs (pycor - cy) = half-h) [
      set pcolor [ 44 48 58 ]
    ] [
      set pcolor [ 62 68 78 ]
    ]
  ]

  ;; 3. Rooftop HVAC Machinery
  ask patches with [ (pxcor = cx - 1 or pxcor = cx) and (pycor = cy or pycor = cy + 1) ] [
    set pcolor [ 90 96 110 ]
  ]

  ;; 4. Hospital Helipad 'H'
  if b-type = "hospital" [
    ask patches with [ abs (pxcor - cx) &lt;= 2 and abs (pycor - cy) &lt;= 2 ] [
      if (abs (pxcor - cx) = 2 or abs (pycor - cy) = 2) [ set pcolor [ 180 160 40 ] ]
      if (abs (pxcor - cx) = 1 and abs (pycor - cy) &lt;= 1) or (pxcor = cx and pycor = cy) [
        set pcolor [ 240 240 245 ]
      ]
    ]
  ]

  ;; 5. Earthquake Damage Void &amp; Masonry Spillage
  if collapsed? [
    let hole-x (cx + half-w - 1)
    let hole-y (cy - half-h + 1)
    ask patches with [ abs (pxcor - hole-x) &lt;= 2 and abs (pycor - hole-y) &lt;= 2 ] [
      set pcolor [ 30 25 22 ]
    ]
    ask patches with [ abs (pxcor - (cx + half-w)) &lt;= 1 and abs (pycor - (cy - half-h)) &lt;= 1 ] [
      set obstacle? false      ;; Flyable rubble fringe
      ifelse random-float 1.0 &lt; 0.5 [ set pcolor [ 88 68 52 ] ] [ set pcolor [ 65 60 55 ] ]
    ]
  ]
end

to setup-survivors
  ;; Survivors spawn on open ground across streets or rubble edges
  let candidate-patches patches with [
    not obstacle? and
    (pxcor &gt; min-pxcor + 11 or pycor &gt; min-pycor + 11)
  ]

  let count-to-spawn min list SURVIVOR_COUNT (count candidate-patches)

  ask n-of count-to-spawn candidate-patches [
    sprout-survivors 1 [
      set found? false
      ifelse random-float 1.0 &lt; 0.4 [
        set priority "critical"
        set color [ 255 55 75 ]   ;; Red beacon (immediate medical urgency)
      ] [
        set priority "stable"
        set color [ 255 175 25 ]  ;; Amber beacon (delayed triage)
      ]
      set shape "x"
      set size 2.8
    ]
  ]
end

to setup-drones
  let drone-colors (list [ 0 240 255 ] [ 255 230 0 ] [ 180 100 255 ] [ 0 255 180 ])
  let i 0

  create-drones DRONE_COUNT [
    set shape "airplane"
    set size 3.6
    set color item (i mod length drone-colors) drone-colors
    set battery initial-battery
    set my-found-count 0

    ;; Take off from Base Tarmac
    setxy (min-pxcor + 2 + (i * 1.5)) (min-pycor + 2 + (i * 1.5))
    set heading 45 + (i * 30)

    ;; Trajectory trail
    pen-down
    set pen-size 1.8

    ;; Glowing detection radar halo
    let parent self
    let h nobody
    hatch-halos 1 [
      set shape "circle"
      set hidden? false
      set size (DETECTION_RADIUS * 2)
      set color [ 0 220 255 55 ]   ;; More visible translucent sonar bubble
      set owner-drone parent
      pen-up
      set h self
    ]
    set my-halo h
    set i i + 1
  ]
end

;; ============================================================================
;; SIMULATION LOOP (GO)
;; ============================================================================

to go
  ;; Halting Conditions
  if (found-count &gt;= count survivors) [
    set mission-status "Mission Success: All Located!"
    stop
  ]
  if (count drones with [ battery &gt; 0 ] = 0) [
    set mission-status "Mission Failed: All Batteries Dead"
    stop
  ]
  if (ticks &gt;= MAX_STEPS) [
    set mission-status "Mission Stopped: Time Limit"
    stop
  ]

  ask drones with [ battery &gt; 0 ] [
    move-drone
    perform-scan
    update-radar-halo

    set battery battery - 1
    if battery &lt;= 0 [
      set color gray
      pen-up
      if my-halo != nobody [ ask my-halo [ die ] ]
    ]
  ]

  update-ca-grid
  update-metrics
  tick
  update-sar-plot
end

;; ============================================================================
;; DRONE KINEMATICS &amp; COLLISION-FREE SWARM AVOIDANCE
;; ============================================================================

to move-drone
  ;; 1. Correlated Random Turn
  let turn-degrees (TURN_NOISE * 180 / pi)
  rt (random-normal 0 turn-degrees)

  let final-vx dx
  let final-vy dy
  let my-x xcor
  let my-y ycor

  ;; 2. Stronger coverage steering: target the nearest unvisited,
  ;; obstacle-free patch in the whole map, not just a nearby patch.
  ;; The target direction dominates random wandering, reducing repeated
  ;; loops over scanned ground. Obstacle avoidance below still has priority.
  let unvisited-target min-one-of patches with
    [ not visited? and not obstacle? ] [ distance myself ]
  if unvisited-target != nobody [
    let target-x [pxcor] of unvisited-target
    let target-y [pycor] of unvisited-target
    let target-dx (target-x - my-x)
    let target-dy (target-y - my-y)
    let target-mag sqrt (target-dx * target-dx + target-dy * target-dy)
    if target-mag &gt; 0 [
      ;; Keep a small amount of the correlated random direction, but strongly
      ;; bias the drone toward the nearest unvisited patch.
      set final-vx (0.20 * final-vx) + (1.80 * target-dx / target-mag)
      set final-vy (0.20 * final-vy) + (1.80 * target-dy / target-mag)
    ]
  ]

  ;; 3. Building Obstacle Repulsion (Whiskers push away from high-rises)
  let nearby-obstacles patches in-radius 2.0 with [ obstacle? ]
  if any? nearby-obstacles [
    let obs-push-x 0
    let obs-push-y 0
    ask nearby-obstacles [
      let d distance myself
      if d &gt; 0 [
        let ux (my-x - pxcor) / d
        let uy (my-y - pycor) / d
        let strength (1.0 / d)
        set obs-push-x obs-push-x + (ux * strength)
        set obs-push-y obs-push-y + (uy * strength)
      ]
    ]
    set final-vx final-vx + (2.0 * obs-push-x)
    set final-vy final-vy + (2.0 * obs-push-y)
  ]

  ;; 4. Swarm Peer Repulsion (Boids Dispersal Heuristic)
  if repulsion-active? [
    let push-x 0
    let push-y 0
    let nearby other drones in-radius REPULSION_RANGE with [ battery &gt; 0 ]
    if any? nearby [
      ask nearby [
        let d distance myself
        if d &gt; 0 [
          let ux (my-x - xcor) / d
          let uy (my-y - ycor) / d
          let decay (1 - (d / [REPULSION_RANGE] of myself))
          set push-x push-x + (ux * decay)
          set push-y push-y + (uy * decay)
        ]
      ]
      set final-vx final-vx + (REPULSION_WEIGHT * push-x)
      set final-vy final-vy + (REPULSION_WEIGHT * push-y)
    ]
  ]

  ;; Normalize velocity vector
  let mag sqrt (final-vx * final-vx + final-vy * final-vy)
  if mag &gt; 0 [
    set final-vx (final-vx / mag)
    set final-vy (final-vy / mag)
    set heading atan final-vx final-vy
  ]

  ;; 5. Hard Collision Prevention (Bank away if path blocked)
  let forward-p patch-ahead SPEED
  let safe? (forward-p != nobody and not [obstacle?] of forward-p)
  let tries 0
  while [ not safe? and tries &lt; 8 ] [
    rt (ifelse-value (random 2 = 0) [ 45 ] [ -45 ])
    set forward-p patch-ahead SPEED
    set safe? (forward-p != nobody and not [obstacle?] of forward-p)
    set tries tries + 1
  ]

  if safe? [ fd SPEED ]
  bounce-off-walls
end

to bounce-off-walls
  if (xcor &lt;= min-pxcor and dx &lt; 0) or (xcor &gt;= max-pxcor and dx &gt; 0) [
    set heading (360 - heading)
  ]
  if (ycor &lt;= min-pycor and dy &lt; 0) or (ycor &gt;= max-pycor and dy &gt; 0) [
    set heading (180 - heading)
  ]
  set xcor (max list min-pxcor (min list max-pxcor xcor))
  set ycor (max list min-pycor (min list max-pycor ycor))
end

to update-radar-halo
  if my-halo != nobody [
    let my-x xcor
    let my-y ycor
    ask my-halo [
      setxy my-x my-y
      set hidden? false
      set size (DETECTION_RADIUS * 2)
      set color [ 0 220 255 55 ]
    ]
  ]
end

;; ============================================================================
;; RADAR SCANNING, GEOTAGGING &amp; CASUALTY LOGGING
;; ============================================================================

to perform-scan
  ;; 1. Mark scanned ground (CA Stigmergy Footprint)
  let scanned-patches patches in-radius DETECTION_RADIUS with [ not obstacle? ]
  ask scanned-patches [
    set visited? true
    set scent-trail 20
    set pcolor [ 32 75 105 ]  ;; Active sonar blue
  ]

  ;; 2. Detect &amp; Geotag Survivors
  let detected-survivors survivors in-radius DETECTION_RADIUS with [ not found? ]
  if any? detected-survivors [
    ask detected-survivors [
      set found? true
      set shape "circle"
      set size 3.2
      set color [ 0 255 140 ]  ;; Neon Emerald Green (Geotagged &amp; Cataloged)
      ifelse priority = "critical" [
        set critical-found critical-found + 1
      ] [ ]
    ]
    set my-found-count my-found-count + count detected-survivors
    set found-count count survivors with [ found? ]
  ]
end

to update-ca-grid
  ;; CA synchronous decay rule
  ask patches with [ scent-trail &gt; 0 and not obstacle? ] [
    set scent-trail scent-trail - 0.25
    if scent-trail &lt;= 0 [
      set pcolor [ 28 42 58 ]  ;; Settles into permanent mapped-slate
    ]
  ]
end

;; =========================================================================
;; SAR PERFORMANCE PLOT
;; Both lines use percentages so they can be compared on the same 0-100 axis.
;; =========================================================================

to setup-sar-plot
  set-current-plot "SAR Mission Curve"
  clear-plot
  set-current-plot-pen "Survivors Found (%)"
  set-plot-pen-color green
  set-current-plot-pen "Search Coverage (%)"
  set-plot-pen-color sky
end

to update-sar-plot
  set-current-plot "SAR Mission Curve"
  let total-survivors count survivors
  let found-percent 0
  if total-survivors &gt; 0 [
    set found-percent (100 * found-count / total-survivors)
  ]

  set-current-plot-pen "Survivors Found (%)"
  plotxy ticks found-percent

  set-current-plot-pen "Search Coverage (%)"
  plotxy ticks search-coverage
end

to update-metrics
  let unblocked patches with [ not obstacle? ]
  ifelse any? unblocked [
    set search-coverage ((count unblocked with [ visited? ]) / (count unblocked)) * 100
  ] [
    set search-coverage 0
  ]
end</code>
  <widgets>
    <view x="368" wrappingAllowedX="false" y="10" frameRate="30.0" minPycor="-50" height="914" showTickCounter="true" patchSize="9.0" fontSize="10" wrappingAllowedY="false" width="914" tickCounterLabel="ticks" maxPycor="50" updateMode="0" maxPxcor="50" minPxcor="-50" />
    <button x="25" y="20" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="55">setup</button>
    <button x="90" y="20" height="40" disableUntilTicks="false" forever="true" kind="Observer" width="55">go</button>
    <slider x="25" step="1" y="70" max="30" width="150" display="DRONE_COUNT" height="50" min="1" direction="Horizontal" default="4.0" variable="DRONE_COUNT" />
    <slider x="185" step="50" y="70" max="2000" width="150" display="MAX_STEPS" height="50" min="100" direction="Horizontal" default="500.0" variable="MAX_STEPS" />
    <slider x="25" step="0.1" y="125" max="2.0" width="150" display="SPEED" height="50" min="0.5" direction="Horizontal" default="0.6" variable="SPEED" />
    <slider x="185" step="5" y="125" max="100" width="150" display="SURVIVOR_COUNT" height="50" min="5" direction="Horizontal" default="10.0" variable="SURVIVOR_COUNT" />
    <slider x="25" step="0.1" y="180" max="1.5" width="150" display="REPULSION_WEIGHT" height="50" min="0.0" direction="Horizontal" default="0.6" variable="REPULSION_WEIGHT" />
    <slider x="185" step="1" y="180" max="25" width="150" display="obstacle-density" height="50" min="0" direction="Horizontal" default="10.0" variable="obstacle-density" units="%" />
    <switch x="155" y="20" height="40" on="true" variable="repulsion-active?" width="120" display="repulsion-active?" />
    <slider x="25" step="0.5" y="235" max="8.0" width="150" display="DETECTION_RADIUS" height="50" min="1.0" direction="Horizontal" default="2.5" variable="DETECTION_RADIUS" />
    <slider x="185" step="50" y="235" max="1500" width="150" display="initial-battery" height="50" min="200" direction="Horizontal" default="550.0" variable="initial-battery" />
    <slider x="25" step="0.05" y="290" max="1.0" width="150" display="TURN_NOISE" height="50" min="0.05" direction="Horizontal" default="0.25" variable="TURN_NOISE" />
    <slider x="185" step="1.0" y="290" max="20.0" width="150" display="REPULSION_RANGE" height="50" min="2.0" direction="Horizontal" default="10.0" variable="REPULSION_RANGE" />
    <monitor x="25" precision="17" y="350" height="60" fontSize="11" width="310" display="Mission Status">mission-status</monitor>
    <monitor x="25" precision="17" y="415" height="60" fontSize="11" width="310" display="Critical Rescued">critical-found</monitor>
    <plot x="25" autoPlotX="true" yMax="100.0" autoPlotY="false" yAxis="Progress (%)" y="545" xMin="0.0" height="235" legend="true" xMax="10.0" yMin="0.0" width="310" xAxis="Time" display="SAR Mission Curve">
      <setup />
      <update />
      <pen interval="1.0" mode="0" display="Survivors Found (%)" color="-12087248" legend="true">
        <setup />
        <update />
      </pen>
      <pen interval="1.0" mode="0" display="Search Coverage (%)" color="-13345367" legend="true">
        <setup />
        <update />
      </pen>
    </plot>
    <monitor x="25" precision="17" y="790" height="45" fontSize="11" width="150" display="Survivors Found">(word found-count " / " count survivors)</monitor>
    <monitor x="185" precision="17" y="790" height="45" fontSize="11" width="150" display="Survivors Remaining">(count survivors with [ not found? ])</monitor>
    <monitor x="25" precision="17" y="840" height="45" fontSize="11" width="150" display="Detection Rate (%)">(ifelse-value (count survivors &gt; 0) [ precision (100 * found-count / count survivors) 1 ] [ 0 ])</monitor>
    <monitor x="185" precision="17" y="840" height="45" fontSize="11" width="150" display="Search Coverage (%)">(word precision search-coverage 1 "%")</monitor>
  </widgets>
